# Copy to .env.local for `node dev.mjs` (never commit the real file).
GROQ_API_KEY=
# Optional. Free-tier chat models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
# Optional. Live case-law lookups through pakistancaselaw.com's MCP server.
# Set to "off" to answer from the statute alone.
CASELAW_MCP=https://pakistancaselaw.com/mcp
